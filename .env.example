# Figma personal access token — the only credential the MCP server needs.
# Figma → Settings → Security → Personal access tokens, scope "File content: read".
# May also be placed in a `.figma-token` file in your project directory.
FIGMA_TOKEN=figd_REPLACE_WITH_YOUR_TOKEN

# Optional — only for the HEADLESS refine loop (example/refine-example.js).
# The MCP server itself never calls an LLM; the calling agent does the refining.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional — where converted frames are cached.
# Defaults to `.figma-cache/` in the directory the server is started from.
# FIGMA_MCP_CACHE_DIR=
